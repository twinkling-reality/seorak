{
  "name": "@seorak/types",
  "version": "0.2.0",
  "author": "Twinkling Reality",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twinkling-reality/seorak.git",
    "directory": "packages/types"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./event-protocol": {
      "types": "./dist/event-protocol.d.ts",
      "import": "./dist/event-protocol.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js"
    },
    "./event-validation": {
      "types": "./dist/event-validation.d.ts",
      "import": "./dist/event-validation.js"
    },
    "./entitlements": {
      "types": "./dist/entitlements.d.ts",
      "import": "./dist/entitlements.js"
    },
    "./compact-sync": {
      "types": "./dist/compact-sync.d.ts",
      "import": "./dist/compact-sync.js"
    },
    "./data-plane": {
      "types": "./dist/data-plane.d.ts",
      "import": "./dist/data-plane.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "import": "./dist/push.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./intervention": {
      "types": "./dist/intervention.d.ts",
      "import": "./dist/intervention.js"
    },
    "./summary": {
      "types": "./dist/summary.d.ts",
      "import": "./dist/summary.js"
    },
    "./projections": {
      "types": "./dist/projections.d.ts",
      "import": "./dist/projections.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    }
  },
  "scripts": {
    "build:publish": "node scripts/build-package.mjs",
    "prepack": "npm run build:publish",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "peerDependencies": {
    "@mobile-surfaces/surface-contracts": "9.0.0"
  },
  "peerDependenciesMeta": {
    "@mobile-surfaces/surface-contracts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mobile-surfaces/surface-contracts": "9.0.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3"
  }
}
