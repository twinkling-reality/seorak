{
  "name": "@seorak/web",
  "version": "0.0.0",
  "author": "Twinkling Reality",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/public-build-guard.mjs pre development && vite",
    "build": "npm run build:dashboard",
    "build:dashboard": "npm run build:guard:pre && vite build && node scripts/public-build-guard.mjs post --out=dist-dashboard",
    "build:guard:pre": "node scripts/public-build-guard.mjs pre",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "portrait": "tsx scripts/portrait-cards.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/fiber": "^9.6.1",
    "@seorak/types": "*",
    "@shadergradient/react": "^2.4.20",
    "clsx": "^2.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.184.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^27.0.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
